# NASA FIRMS — free instant signup at https://firms.modaps.eosdis.nasa.gov/api/
# Add this in Vercel: Project Settings -> Environment Variables -> FIRMS_MAP_KEY
FIRMS_MAP_KEY=

# OpenSky Network (OPTIONAL). Anonymous access works but is rate-limited to
# ~400 credits/day. Register an OAuth2 client at
# https://opensky-network.org/my-opensky to raise the limit, then set both.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
