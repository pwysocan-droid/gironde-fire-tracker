# --- required ---

# NASA FIRMS — free instant signup at https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=

# Anthropic — powers module 04 SITUATION (the French situation bulletin).
# https://console.anthropic.com/ · model overridable via SITREP_MODEL
ANTHROPIC_API_KEY=

# --- optional: history (sparklines, measured spread, trend in the bulletin) ---

# Set automatically by linking a Vercel Blob store:
#   npx vercel blob create-store <name> --access public --yes
BLOB_READ_WRITE_TOKEN=

# Guards POST /api/snapshot (the GitHub Actions backstop trigger).
# Any long random string; also set it as a GitHub Actions repo secret.
SNAPSHOT_SECRET=

# --- optional: air traffic fallback ---

# OpenSky OAuth2 (https://opensky-network.org/my-opensky). Only useful where
# OpenSky is reachable — it is blocked from Vercel's egress; adsb.lol (no key)
# is the primary source.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
